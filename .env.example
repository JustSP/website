# Brevo (Sendinblue) Configuration
# Get your API key from: https://app.brevo.com/settings/keys/api
VITE_BREVO_API_KEY=your_brevo_api_key_here

# Optional: Newsletter list ID from Brevo
# Get this from: https://app.brevo.com/contacts/lists/
VITE_BREVO_NEWSLETTER_LIST_ID=1

# Google reCAPTCHA v2 Invisible public site key (safe for the browser)
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key_here
# Keep Google Cloud and Brevo API keys on the server; never use VITE_ for secrets.

# Netlify Functions environment only (never prefix secrets with VITE_)
RECAPTCHA_PROJECT_ID=wish-website
RECAPTCHA_GOOGLE_API_KEY=your_private_google_cloud_api_key
RECAPTCHA_MIN_SCORE=0.5
RECAPTCHA_ALLOWED_HOSTNAMES=ww-hub.com,www.ww-hub.com
BREVO_API_KEY=your_server_side_brevo_api_key_here
CONTACT_FROM_EMAIL=connect@ww-hub.com
CONTACT_TO_EMAIL=connect@ww-hub.com
